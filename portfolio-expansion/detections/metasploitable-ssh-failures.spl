index=* host="192.168.159.129" sourcetype=syslog earliest=-5m ("Failed password" OR "authentication failure" OR "Failed publickey") | rex field=_raw "Failed password for (?:invalid user )?(?<failed_user>\S+)" | rex field=_raw "user=(?<pam_user>\S+)" | rex field=_raw " from (?<failed_src_ip>\d{1,3}(?:\.\d{1,3}){3})" | rex field=_raw "rhost=(?<pam_src_ip>\d{1,3}(?:\.\d{1,3}){3})" | eval username=coalesce(failed_user,pam_user), src_ip=coalesce(failed_src_ip,pam_src_ip) | stats count AS failures by src_ip username | where failures >= 3
